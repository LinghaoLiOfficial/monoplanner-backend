# FastAPI 应用名称，通常只影响文档标题和健康检查展示。
APP_NAME=Fullstack Context Orchestrator API
# 允许跨域访问后端的前端源地址，多个地址用英文逗号分隔。
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 应用运行时 PostgreSQL 连接串，开发和生产接口默认使用此数据库。
DATABASE_URL=postgresql+psycopg://llh@localhost:5432/context_orchestrator
# 自动化测试专用 PostgreSQL 连接串，测试库名必须以 _test 结尾以避免误删开发数据。
TEST_DATABASE_URL=postgresql+psycopg://llh@localhost:5432/context_orchestrator_test

# LLM 服务类型，当前支持 OpenAI-compatible 接口。
LLM_PROVIDER=openai_compatible
# OpenAI-compatible API base URL，不要包含 /chat/completions。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM API Key，请只放在本机 .env 或部署环境变量中，不要提交真实密钥。
LLM_API_KEY=replace-with-your-api-key
# LLM 模型名称，例如 qwen-plus。
LLM_MODEL=qwen-plus
# 单次 LLM 请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=90
# 是否启用支持 thinking 参数的模型思考模式。
LLM_THINKING=false

# 后台生成 worker 并发数，当前 worker 入口默认串行执行。
QUEUE_WORKER_CONCURRENCY=1
# worker 空闲时轮询新任务的间隔，单位秒。
QUEUE_POLL_INTERVAL_SECONDS=2
# running 任务超过该秒数未更新时会被视为 stale 并允许恢复。
QUEUE_STALE_AFTER_SECONDS=900
# worker 心跳有效期，生成接口找不到有效心跳时会返回 503。
QUEUE_WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
# 可重试生成任务的最大尝试次数。
QUEUE_MAX_ATTEMPTS=3

# JWT 签名密钥，生产环境必须替换为足够长的随机字符串。
AUTH_SECRET_KEY=replace-with-a-long-random-secret
# 登录 Cookie/JWT 的有效天数。
AUTH_TOKEN_EXPIRE_DAYS=7
# 登录态 HttpOnly Cookie 名称。
AUTH_COOKIE_NAME=access_token
# 是否只通过 HTTPS 发送登录 Cookie，生产 HTTPS 环境建议设为 true。
AUTH_COOKIE_SECURE=false
# 登录 Cookie SameSite 策略，可按前后端部署方式调整。
AUTH_COOKIE_SAMESITE=lax

# 邮箱验证码有效期，单位分钟。
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
# 同一邮箱重复发送验证码的冷却时间，单位秒。
EMAIL_VERIFICATION_RESEND_SECONDS=60

# SMTP 服务器主机；留空时验证码只写后端日志，便于本地开发。
SMTP_HOST=
# SMTP 服务器端口。
SMTP_PORT=587
# SMTP 登录用户名；无认证或本地开发可留空。
SMTP_USERNAME=
# SMTP 登录密码；无认证或本地开发可留空。
SMTP_PASSWORD=
# 发送验证码邮件使用的发件人地址。
SMTP_FROM_EMAIL=
# 是否使用 TLS 连接 SMTP 服务器。
SMTP_USE_TLS=true

# 迁移或初始化时用于接收历史项目的 bootstrap admin 邮箱。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# bootstrap admin 用户名。
BOOTSTRAP_ADMIN_USERNAME=admin
# bootstrap admin 初始密码，生产环境必须立即替换。
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
